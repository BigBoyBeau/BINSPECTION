  <!--
    Explicitly hooked to the Build target (rather than relying on the
    legacy "AfterBuild" magic-target-name extension point) so this always
    fires the same way regardless of which MSBuild host runs the build -
    including `dotnet build`, which is how this project gets built outside
    Visual Studio.
  -->
  <Target Name="RegisterBinspectionComServer" AfterTargets="Build" Condition="'$(RegAsmExe)' != ''">
    <!--
      ContinueOnError so a build run without Administrator rights (regasm
      needs to write to HKLM) still produces BINSPECTION.dll instead of
      hard-failing the whole build - regasm is always attempted either way,
      it just can't complete without elevation. Re-run from an elevated
      prompt (or install/regsvcs the DLL separately) to actually register
      it for SolidWorks to load.
    -->
    <Exec Command="&quot;$(RegAsmExe)&quot; &quot;$(TargetPath)&quot; /codebase" ContinueOnError="WarnAndContinue" />
  </Target>
  <Target Name="WarnIfRegAsmMissing" AfterTargets="Build" Condition="'$(RegAsmExe)' == ''">
    <Warning Text="regasm.exe was not found at either well-known .NET Framework path - BINSPECTION.dll was built but NOT re-registered for COM interop. SolidWorks may still be using a stale registration." />
  </Target>
