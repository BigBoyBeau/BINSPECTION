<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <runtime>
        <!-- Lets ZoomToAndHighlight's catch block (BalloonManagerWindow.xaml.cs)
             actually receive an AccessViolationException/SEHException from a
             Select3 call on a dangling annotation, instead of the CLR treating
             it as an uncatchable corrupted-state exception and killing SolidWorks. -->
        <legacyCorruptedStateExceptionsPolicy enabled="true"/>
    </runtime>
    <appSettings>
    </appSettings>
</configuration>
