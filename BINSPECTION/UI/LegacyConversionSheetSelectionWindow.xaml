<Window x:Class="BINSPECTION.UI.LegacyConversionSheetSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Legacy Conversion"
        Height="520" Width="460"
        MinHeight="380" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BINSPECTION;component/UI/Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10" Background="{StaticResource BgBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="Check which sheets' balloons are eligible for legacy conversion this run. A balloon on an unchecked sheet is left alone - it can be converted in a later run. A characteristic whose sheet isn't known is always included, since it can't be excluded safely." />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Select All" Width="120" Margin="0,0,8,0" Click="SelectAll_Click" />
            <Button Content="Select None" Width="120" Click="SelectNone_Click" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="SheetsGrid"
                  ItemsSource="{Binding Sheets, ElementName=RootWindow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <!-- Plain CheckBox in a template cell, not
                     DataGridCheckBoxColumn - see CreateBalloonsSheetSelectionWindow
                     for why (single-click-doesn't-commit bug). -->
                <DataGridTemplateColumn Header="Convert" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Sheet" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Continue" Width="110" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Continue_Click" />
            <Button Content="Cancel" Width="110" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
