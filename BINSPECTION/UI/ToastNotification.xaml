<Window x:Class="BINSPECTION.UI.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="420">
    <Border Background="#171D22"
            BorderBrush="#2A3A46"
            BorderThickness="1,1,1,1"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="24" ShadowDepth="6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
            </Grid.RowDefinitions>

            <!-- accent bar on the left edge -->
            <Border x:Name="AccentBar"
                    Grid.Row="0"
                    Width="3"
                    HorizontalAlignment="Left"
                    Background="#57C77A"
                    CornerRadius="6,0,0,0" />

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,16,18,14">
                <Grid Width="26" Height="26" Margin="0,1,12,0" VerticalAlignment="Top">
                    <Path x:Name="CheckIcon"
                          Data="M4,12 L9,17 L20,5"
                          Stroke="#57C77A"
                          StrokeThickness="2.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                    <Ellipse x:Name="CheckRing"
                             Stroke="#57C77A"
                             StrokeThickness="2.4"
                             Width="24" Height="24" />
                    <Path x:Name="WarnIcon"
                          Visibility="Collapsed"
                          Data="M12,9 L12,13 M12,17 L12,17.2 M11,3.6 L2.6,18 A1.8,1.8 0 0 0 4.2,20.7 L19.8,20.7 A1.8,1.8 0 0 0 21.4,18 L13,3.6 A1.8,1.8 0 0 0 11,3.6 Z"
                          Stroke="#E0A857"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Grid>
                <StackPanel Width="330">
                    <TextBlock x:Name="TitleText"
                               Text="Title"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#E7EFF3" />
                    <TextBlock x:Name="DetailText"
                               Text="Detail"
                               FontSize="13"
                               Foreground="#7C8B99"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <Border x:Name="ProgressBar"
                    Grid.Row="1"
                    Background="#57C77A"
                    HorizontalAlignment="Left"
                    Width="420" />
        </Grid>
    </Border>
</Window>
