<UserControl x:Class="BINSPECTION.UI.TaskPane.BalloonManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootPanel"
             MinWidth="640">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BINSPECTION;component/UI/Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Compact icon+label toolbar button, replaces the ribbon-style
                 buttons in the approved mockup - hand-drawn stroke icons
                 weren't worth the XAML Path markup for an internal tool, so
                 these use short text glyphs instead while keeping the same
                 dark/cyan visual language. -->
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="14,11" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0,0,6,6" />
            </Style>

            <!-- Destructive-action button (Delete All Balloons) - amber
                 border/text instead of the flat neutral look every other
                 button gets, so it doesn't blend in with routine actions. -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                <Setter Property="Opacity" Value="0.85" />
                <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
            </Style>

            <!-- iOS-style toggle switch built from a CheckBox, used for
                 Snap to Selection. -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Track"
                                    Width="52" Height="28"
                                    CornerRadius="14"
                                    Background="#26333F"
                                    BorderBrush="#2A3A46"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Border x:Name="Knob"
                                        Width="20" Height="20"
                                        CornerRadius="10"
                                        Background="#0C1116"
                                        HorizontalAlignment="Left"
                                        Margin="3,0,0,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#2AACC8" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgHeader}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,14,16,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentCyan}" VerticalAlignment="Top" Margin="0,5,10,0" />
                <StackPanel>
                    <TextBlock Text="BALLOON MANAGER" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextHeading}" />
                    <TextBlock Text="{Binding SubtitleText, ElementName=RootPanel}" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- submenu nav: every other BINSPECTION command, reachable from
             right here instead of only from the ribbon. Sheet Tolerances/
             Create Balloons/Save Position/Restore Position/Generate Report
             bubble up to CommandManagerHandler (via TaskPaneHostControl),
             which runs the exact same On* method the ribbon button does -
             no logic duplicated. Legacy Conversion opens directly since
             this panel already holds the model/data context it needs. -->
        <StackPanel Grid.Row="1" Margin="12,10,12,0">
            <TextBlock Text="PROJECT" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="2,0,0,4" />
            <WrapPanel>
                <Button Content="Sheet Tolerances" Style="{StaticResource ToolButton}" Click="SheetTolerances_Click" ToolTip="Sheet Tolerance Selection" />
                <Button Content="Create Balloons" Style="{StaticResource ToolButton}" Click="CreateBalloons_Click" ToolTip="Scan the drawing and balloon new dimensions" />
                <Button Content="Remove Balloons" Style="{StaticResource ToolButton}" Click="RemoveBalloons_Click" ToolTip="Remove every balloon's visual from the sheet (saved data is kept)" />
                <Button Content="Save Position" Style="{StaticResource ToolButton}" Click="SavePosition_Click" ToolTip="Save every balloon's current position" />
                <Button Content="Restore Position" Style="{StaticResource ToolButton}" Click="RestorePosition_Click" ToolTip="Restore every balloon to its last saved position" />
                <Button Content="Generate Report" Style="{StaticResource ToolButton}" Click="GenerateReport_Click" ToolTip="Generate the inspection report" />
                <Button Content="Reset" Style="{StaticResource ToolButton}" Click="Reset_Click" ToolTip="Re-sync this panel with the active drawing's saved data - clears any leftover rows from a previously viewed drawing" />
                <Button Content="Delete All Balloons" Style="{StaticResource DangerButton}" Click="DeleteAllBalloons_Click" ToolTip="Delete every balloon and all saved balloon data - not reversible" />
            </WrapPanel>
        </StackPanel>

        <!-- toolbar -->
        <StackPanel Grid.Row="2" Margin="12,14,12,0">
            <TextBlock Text="BALLOONS" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="2,0,0,4" />
            <WrapPanel>
                <Button Content="Group" Style="{StaticResource ToolButton}" Click="Group_Click" ToolTip="Join checked balloons into one group" />
                <Button Content="Ungroup" Style="{StaticResource ToolButton}" Click="Ungroup_Click" ToolTip="Split checked group members back out" />
                <Button Content="Add" Style="{StaticResource ToolButton}" Click="Add_Click" ToolTip="Balloon checked unballooned dimensions" />
                <Button Content="De-#" Style="{StaticResource ToolButton}" Click="DeNumber_Click" ToolTip="Remove the checked balloon(s) and free up their number(s) to be assigned elsewhere - Method/Classification are kept" />
                <Button Content="Re-#" Style="{StaticResource ToolButton}" Click="ReNumber_Click" ToolTip="Type a specific balloon number for each checked row" />
                <Button Content="Legacy..." Style="{StaticResource ToolButton}" Click="LegacyConversion_Click" ToolTip="Legacy Conversion" />
            </WrapPanel>
        </StackPanel>

        <!-- sheet filter + snap toggle -->
        <Grid Grid.Row="3" Margin="12,8,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Sheet:" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="13" Margin="0,0,8,0" />
                <ComboBox Width="200" ItemsSource="{Binding SheetNames, ElementName=RootPanel}"
                          SelectedItem="{Binding SelectedSheet, ElementName=RootPanel}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,10,0,0" Padding="14" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Snap to Selection" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextHeading}" />
                        <TextBlock Text="Selecting a row centers the SOLIDWORKS view on that dimension." FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding SnapToSelectionEnabled, ElementName=RootPanel}" Checked="SnapToggle_Changed" Unchecked="SnapToggle_Changed" />
                </Grid>
            </Border>
        </Grid>

        <!-- bulk bar -->
        <Border Grid.Row="4" Margin="12,10,12,0" Padding="14" Background="#264FC7E8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding HasSelection, ElementName=RootPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CheckedCountText, ElementName=RootPanel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextHeading}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Clear" Padding="12,6" MinHeight="0" FontSize="12.5" Click="ClearSelection_Click" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="BulkMethodCombo" IsEditable="True" ItemsSource="{Binding MethodOptions, ElementName=RootPanel}" />
                    <ComboBox Grid.Column="2" x:Name="BulkClassCombo" IsEditable="True" ItemsSource="{Binding ClassOptions, ElementName=RootPanel}" />
                </Grid>
                <Button Content="Apply to Checked" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Click="ApplyBulkAttributes_Click" />
            </StackPanel>
        </Border>

        <!-- row list: a real grid, every characteristic's full data (incl.
             legacy balloon #, when this drawing has one) visible in its own
             row/column at once - no expand/collapse step. Method/
             Classification/Sheet stay directly editable in-cell (plain
             ComboBoxes in a CellTemplate, not DataGrid's own click-to-edit
             mode) so editing them works the same single click as before. -->
        <DataGrid Grid.Row="5" Margin="0,8,0,0"
                  x:Name="BalloonsGrid"
                  ItemsSource="{Binding Rows, ElementName=RootPanel}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  RowHeight="NaN"
                  SelectionUnit="FullRow"
                  SelectionMode="Single"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  SelectionChanged="BalloonsGrid_SelectionChanged">
            <DataGrid.Columns>
                <!-- Plain CheckBox in a template cell, not
                     DataGridCheckBoxColumn - the latter's generated display
                     checkbox is hit-test-disabled until the cell becomes
                     "current," which could make a single click just select
                     the row instead of reliably toggling/committing. -->
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Click="SelectedCheckBox_Click" Tag="{Binding}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="#" Binding="{Binding DisplayNumber}" IsReadOnly="True" Width="44">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Dimension" Binding="{Binding DimensionDisplay}" IsReadOnly="True" Width="2*" MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Method" Width="130" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" Text="{Binding Method, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.MethodOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsEnabled="{Binding HasCharacteristic}"
                                      LostFocus="MethodOrClass_LostFocus" Tag="{Binding}"
                                      MinHeight="0" Padding="6,4" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Classification" Width="130" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" Text="{Binding Class, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.ClassOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsEnabled="{Binding HasCharacteristic}"
                                      LostFocus="MethodOrClass_LostFocus" Tag="{Binding}"
                                      MinHeight="0" Padding="6,4" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Sheet" Width="110" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding SheetName, Mode=TwoWay}"
                                      ItemsSource="{Binding DataContext.SheetNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsEnabled="{Binding HasBalloon}"
                                      SelectionChanged="SheetCombo_SelectionChanged" Tag="{Binding}"
                                      MinHeight="0" Padding="6,4" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Legacy #" Binding="{Binding LegacyBalloonNumber}" IsReadOnly="True" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Basic" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsBasic, Mode=TwoWay}"
                                      Click="BasicCheckBox_Click" Tag="{Binding}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="&#9888;" FontSize="15" Foreground="{StaticResource Amber}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       ToolTip="Dimension not found - showing balloon note only"
                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- footer -->
        <Border Grid.Row="6" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,10">
            <TextBlock Text="{Binding FooterText, ElementName=RootPanel}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextDim}" />
        </Border>
    </Grid>
</UserControl>
