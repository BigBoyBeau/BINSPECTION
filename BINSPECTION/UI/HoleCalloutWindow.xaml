<Window x:Class="BINSPECTION.UI.HoleCalloutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Add Hole Callout"
        Height="960" Width="760"
        MinHeight="560" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BINSPECTION;component/UI/Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,10,10" />
            </Style>
            <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="110" />
                <Setter Property="Margin" Value="0,0,24,10" />
            </Style>
            <Style x:Key="FieldGroup" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
            <Style x:Key="FieldCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,24,10" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource BgBase}">
        <Grid Margin="0,20,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The whole form scrolls, so on a short screen the
                 characteristics grid keeps a readable height instead of
                 being squeezed to nothing. -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,0">

            <TextBlock x:Name="HeaderText" Margin="0,0,0,18" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{StaticResource TextDim}" />

            <!-- Saved styles: pick one from the remembered folder (filtered
                 to the current type), browse for one, or save this setup -->
            <GroupBox Header="Style" Style="{StaticResource FieldGroup}">
                <StackPanel Margin="10,6,10,0">
                    <WrapPanel>
                        <ComboBox x:Name="StyleCombo" Width="300" Margin="0,0,14,10"
                                  SelectionChanged="StyleCombo_SelectionChanged"
                                  ToolTip="Styles saved in the styles folder for this hole type - pick one to apply it" />
                        <Button Content="Load Style..." Width="130" Margin="0,0,10,10" Click="LoadStyle_Click"
                                ToolTip="Browse for a saved style file and apply it" />
                        <Button Content="Save Style..." Width="130" Margin="0,0,0,10" Click="SaveStyle_Click"
                                ToolTip="Save everything set here as a reusable style file" />
                    </WrapPanel>
                    <TextBlock x:Name="StyleFolderText" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
                </StackPanel>
            </GroupBox>

            <!-- Type / size / quantity / precision -->
            <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="TypeCombo" Width="140" Margin="0,0,24,10" SelectionChanged="TypeCombo_SelectionChanged" />
                <TextBlock Text="Size" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="SizeCombo" Width="160" Margin="0,0,24,10" IsEditable="True"
                          SelectionChanged="SizeCombo_SelectionChanged" ToolTip="Pick a size to fill in the table defaults, or type your own" />
                <TextBlock Text="Qty" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="QuantityBox" Width="56" Margin="0,0,24,10" TextChanged="Field_Changed" />
                <TextBlock Text="Decimals" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="DecimalsCombo" Width="70" Margin="0,0,0,10" SelectionChanged="Decimals_SelectionChanged" />
            </WrapPanel>

            <StackPanel>
                <!-- Thread (Tapped) -->
                <GroupBox x:Name="ThreadGroup" Header="Thread" Style="{StaticResource FieldGroup}">
                    <WrapPanel Margin="10,6,10,0">
                        <TextBlock Text="Designation" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ThreadDesignationBox" Width="140" Margin="0,0,24,10" TextChanged="Field_Changed" />
                        <TextBlock Text="Class" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ThreadClassBox" Width="60" Margin="0,0,24,10" TextChanged="Field_Changed" />
                        <TextBlock Text="Depth" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ThreadDepthBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                        <CheckBox x:Name="ThreadThruCheck" Content="THRU" Style="{StaticResource FieldCheck}" Click="Thru_Click" />
                    </WrapPanel>
                </GroupBox>

                <!-- Hole / tap drill -->
                <GroupBox x:Name="HoleGroup" Header="Hole" Style="{StaticResource FieldGroup}">
                    <WrapPanel Margin="10,6,10,0">
                        <TextBlock x:Name="DrillDiameterLabel" Text="Diameter" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DrillDiameterBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                        <TextBlock Text="Depth" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DrillDepthBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                        <CheckBox x:Name="DrillThruCheck" Content="THRU" Style="{StaticResource FieldCheck}" Click="Thru_Click" />
                        <CheckBox x:Name="AddCountersinkCheck" Content="Add countersink" Style="{StaticResource FieldCheck}" Click="Thru_Click" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox x:Name="CounterboreGroup" Header="Counterbore" Style="{StaticResource FieldGroup}">
                    <WrapPanel Margin="10,6,10,0">
                        <TextBlock Text="Diameter" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CounterboreDiameterBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                        <TextBlock Text="Depth" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CounterboreDepthBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox x:Name="CountersinkGroup" Header="Countersink" Style="{StaticResource FieldGroup}">
                    <WrapPanel Margin="10,6,10,0">
                        <TextBlock Text="Diameter" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CountersinkDiameterBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                        <TextBlock Text="Angle (°)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CountersinkAngleBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox x:Name="SpotfaceGroup" Header="Spotface" Style="{StaticResource FieldGroup}">
                    <WrapPanel Margin="10,6,10,0">
                        <TextBlock Text="Diameter" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SpotfaceDiameterBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                        <TextBlock Text="Depth" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SpotfaceDepthBox" Style="{StaticResource FieldBox}" TextChanged="Field_Changed" />
                    </WrapPanel>
                </GroupBox>
            </StackPanel>

            <!-- One row per characteristic that will be created -->
            <StackPanel Margin="0,4,0,0">
                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextDim}"
                           Text="Characteristics to create. Enter a tolerance only where the value has its own - anything left blank gets the sheet tolerance for its decimal places in the report." />
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Move Down ▼" Width="140" Click="MoveDown_Click"
                            ToolTip="Move the selected row one place down" />
                    <Button DockPanel.Dock="Right" Content="Move Up ▲" Width="140" Margin="0,0,10,0" Click="MoveUp_Click"
                            ToolTip="Move the selected row one place up" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,16,0"
                               Text="Select a row and move it to reorder. The top row carries the balloon's own number; the rest follow as .1, .2..." />
                </DockPanel>
                <DataGrid
                          x:Name="ValuesGrid"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ItemsSource="{Binding Values, ElementName=RootWindow}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          RowHeight="34"
                          MinHeight="170">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" IsReadOnly="True" Width="56">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="12,0,6,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Characteristic" Binding="{Binding Text}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="12,0,12,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="+ Tol" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Plus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanTolerance}" Margin="6,3" VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="− Tol" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Minus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanTolerance}" Margin="6,3" VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- Live preview of the note that will be placed on the drawing -->
            <Border Grid.Row="1" Margin="24,18,24,0" Padding="16,12" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Callout preview" Foreground="{StaticResource TextDim}" Margin="0,0,0,8" />
                    <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="15" LineHeight="22" TextWrapping="Wrap"
                               Foreground="{StaticResource TextHeading}" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,20,24,0">
                <Button x:Name="OkButton" Content="Create" Width="120" Margin="0,0,12,0" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
                <Button Content="Cancel" Width="120" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
